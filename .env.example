# Copier en .env (a la racine, a cote de docker-compose.yml) avant `docker compose up`.

DJANGO_SECRET_KEY=changez-moi
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=securedoc
POSTGRES_USER=securedoc_user
POSTGRES_PASSWORD=changez-moi

# Cle de chiffrement des documents (Fernet). A generer une seule fois :
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENTS_ENCRYPTION_KEY=

BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SESSION_LIFETIME_MINUTES=30
ACTIVATION_DUREE_VALIDITE_JOURS=15
DELAI_JUSTIFICATION_JOURS=30
DELAI_MISE_EN_DEMEURE_JOURS=8
SEUIL_VOYAGE_XAF=5000000
SEUIL_LIGNE_XAF=1000000

# SMTP optionnel : sans ces valeurs, les emails sont affiches dans les logs du conteneur backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@bgfi.ga
SMTP_USE_SSL=0
